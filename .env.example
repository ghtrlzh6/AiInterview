# ============================================
# AI 模拟面试平台 - 环境变量配置模板
# 复制为 .env 后按需填写
# 生产部署完整说明见 docs/deployment.md
# ============================================

# ---------- 数据库（远端 MySQL，本地开发用 docker-compose）----------
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=dev123456

# ---------- JWT（生产环境请更换为随机 32+ 字符）----------
JWT_SECRET=ai-interview-jwt-secret-key-256bits-minimum!!

# ---------- DeepSeek LLM（暂未配置可留空，系统将使用模拟回复）----------
LLM_API_KEY=

# ---------- Chroma 向量库（RAG，可选）----------
CHROMA_HOST=localhost

# ---------- 讯飞 ASR 备用（可选）----------
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ---------- 文件上传目录 ----------
UPLOAD_DIR=./uploads

# ---------- 报告分享链接前缀（生产环境改为域名）----------
SHARE_BASE_URL=http://localhost:5173/share

# ---------- 代码沙箱 Piston（手撕代码运行）----------
# 公共 API 自 2026-02-15 起需 Key，课设推荐自建 Docker（见 README）
PISTON_API_URL=http://127.0.0.1:2000/api/v2/execute
# PISTON_API_KEY=
